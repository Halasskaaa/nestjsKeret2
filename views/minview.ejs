<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>

    <form action="/minview" method="get">
        <label for="minViews">Minimum Views:</label>
        <input type="number" id="minViews" name="minViews" value="<%= minViews %>" min="0">
        <button type="submit">Filter</button>
    </form>
    
    <% if(articles.length === 0) { %>
        <p>Nincs találat.</p>
    <% } else { %>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Visits</th>
            </tr>
        </thead>
        <tbody>
            <% articles.forEach(article => { %>
                <tr>
                    <td><a href="<%= article.url %>"><%= article.title %></a></td>
                    <td><%= article.views %></td>
                </tr>
            <% }); %>
        </tbody>
        <% } %>

        <div class="footer">
            <a href="/">Főoldal</a> <br>
            <a href="/new ">Új adat</a>               
        </div>
         
</body>
</html>