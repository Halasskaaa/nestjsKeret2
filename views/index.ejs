<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Visits</th>
            </tr>
        </thead>
        <tbody>
            <% articles.forEach(article => { %>
                <tr class="<%= article.views > 1000 ? 'bold' : '' %>">
                    <td><a href="<%= article.url %>"><%= article.title %></a></td>
                    <td><%= article.views %></td>
                </tr>
            <% }) %>
        </tbody>
</body>
</html>